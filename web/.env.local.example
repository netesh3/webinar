# Copy to web/.env.local (gitignored). Used by `next dev`.
#
# Auth bypass fakes a signed-in host. Sign out sets sessionStorage
# webcast.devBypassOff=1 (cookie mirror) so `/` shows marketing without editing
# this file. Re-enable: “Continue as Preview Host”, /preview, or /?bypass=1.
# Force marketing anytime: /?marketing=1 or /home.

NEXT_PUBLIC_API_BASE=
API_INTERNAL_URL=http://localhost:8080

# Optional: skip login for local UI redesign preview (next dev only).
# NEVER set this in Cloudflare Worker / production builds.
# NEXT_PUBLIC_DEV_BYPASS_AUTH=1

# UI redesign (marketing home, simplified nav, room side rail). Production
# default is classic unless this is 1. Override anytime with ?ui=new|classic
# or cookie webcast_ui=new|classic (account menu toggle sets the cookie).
# NEXT_PUBLIC_UI_REDESIGN=1

# Optional: Google OAuth Web client ID for One Tap / FedCM on `/` and `/login`.
# Must match the client ID configured for Supabase Auth → Google.
# Falls back to GOOGLE_CLIENT_ID from the API (`googleClientId` in /api/config)
# when that is set for Drive. One Tap no-ops if neither is present.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
