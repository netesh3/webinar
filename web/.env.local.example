# Copy to web/.env.local (gitignored). Used by `next dev`.
#
# Auth bypass fakes a signed-in host session. When set, `/` redirects to `/host`
# (no marketing homepage). Turn it off to preview marketing + Google One Tap:
#   NEXT_PUBLIC_DEV_BYPASS_AUTH=0
# or unset the variable and restart `next dev`.

NEXT_PUBLIC_API_BASE=
API_INTERNAL_URL=http://localhost:8080

# Optional: skip login for local UI redesign preview (next dev only).
# NEVER set this in Cloudflare Worker / production builds.
# NEXT_PUBLIC_DEV_BYPASS_AUTH=1

# Optional: Google OAuth Web client ID for One Tap / FedCM on `/` and `/login`.
# Must match the client ID configured for Supabase Auth → Google.
# Falls back to GOOGLE_CLIENT_ID from the API (`googleClientId` in /api/config)
# when that is set for Drive. One Tap no-ops if neither is present.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
