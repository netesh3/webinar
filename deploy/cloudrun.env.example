# Copy to deploy/cloudrun.env (gitignored) and fill in real values.
# Used by deploy/cloudrun-deploy.sh. CI can instead map GitHub Actions secrets
# into the job environment (see .github/workflows/cloudrun-deploy.yml).

# --- GCP ---
GCP_PROJECT=ai-project-490516
GCP_REGION=asia-south1
AR_REPO=webcast
SERVICE_NAME=webcast-api
IMAGE_NAME=webcast-api

# --- Required for a live Cloud Run service ---
# Prefer Supabase for production (see deploy/SUPABASE.md). Always use sslmode=require.
#
# Session pooler :5432 (recommended — IPv4 + full sessions for migrate/pgx):
#   postgres://postgres.<PROJECT_REF>:SECRET@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct (often IPv6-only on newer projects):
#   postgres://postgres:SECRET@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#
# Transaction pooler (optional; needs simple_protocol for pgx):
#   postgres://postgres.<PROJECT_REF>:SECRET@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol
#
# Legacy Cloud SQL unix socket (leave CLOUD_SQL_INSTANCE set if you use this):
#   postgres://USER:PASS@/webcast?host=/cloudsql/PROJECT:REGION:INSTANCE&sslmode=disable
DATABASE_URL=

# Session cookie signing key: >=32 random bytes. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# LiveKit — prefer LIVEKIT_PROJECTS JSON; legacy LIVEKIT_* still works for one project.
# LIVEKIT_PROJECTS=[{"id":"default","url":"wss://YOUR.livekit.cloud","api_key":"...","api_secret":"..."}]
LIVEKIT_URL=wss://
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_HTTP_URL=   # optional; defaults from LIVEKIT_URL

# --- Admin bootstrap (optional; required on a fresh DB with no operators) ---
# Comma-separated emails. Password must be ≥ MIN_PASSWORD_LENGTH (10 in production).
# On API boot, EnsureAdminAccount creates missing accounts; PromoteAdmins reconciles is_admin.
# ADMIN_EMAILS=ops@example.com
# ADMIN_PASSWORD=change-me-at-least-10-chars

# --- Production knobs (script sets sensible defaults if omitted) ---
APP_ENV=production
COOKIE_SECURE=true
RECORDINGS_ENABLED=false
SEED_DEV=false
# Comma-separated origins are OK — deploy script uses --env-vars-file (not
# comma-joined --set-env-vars), so multiple origins do not break gcloud parsing.
CORS_ORIGINS=https://YOUR_FRONTEND_ORIGIN
WEB_BASE_URL=https://YOUR_FRONTEND_ORIGIN
APP_NAME=Webinar Liv

# --- Supabase Auth (Google sign-in) — optional; password login works without these ---
# Project Settings → API. JWT Secret never goes to the browser.
# See deploy/SUPABASE.md § Auth — Google via Supabase.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=eyJ...anon
# SUPABASE_JWT_SECRET=

# Optional: Cloud SQL only. Leave unset when DATABASE_URL points at Supabase.
# CLOUD_SQL_INSTANCE=ai-project-490516:asia-south1:webcast
