# Copy to deploy/cloudrun.env (gitignored) and fill in real values.
# Used by deploy/cloudrun-deploy.sh. In GitHub Actions, set the same names as
# repository secrets instead (see .github/workflows/cloudrun-deploy.yml).
#
# Never commit real secrets. Placeholders only below.

# --- GCP ---
GCP_PROJECT=ai-project-490516
GCP_REGION=us-central1
AR_REPO=webcast
SERVICE_NAME=webcast-api
IMAGE_NAME=webcast-api

# --- Required for a live Cloud Run service ---
# Postgres connection string (Cloud SQL unix socket or Neon/etc).
# Cloud SQL example:
#   postgres://USER:PASS@/webcast?host=/cloudsql/PROJECT:REGION:INSTANCE&sslmode=disable
DATABASE_URL=

# Session cookie signing key: >=32 random bytes. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# LiveKit — prefer LIVEKIT_PROJECTS JSON; legacy LIVEKIT_* still works for one project.
# LIVEKIT_PROJECTS=[{"id":"default","url":"wss://YOUR_PROJECT.livekit.cloud","api_key":"YOUR_API_KEY","api_secret":"YOUR_API_SECRET"}]
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
# LIVEKIT_HTTP_URL=   # optional; defaults from LIVEKIT_URL

# --- Production knobs (script sets sensible defaults if omitted) ---
APP_ENV=production
COOKIE_SECURE=true
RECORDINGS_ENABLED=false
SEED_DEV=false
CORS_ORIGINS=https://YOUR_FRONTEND_ORIGIN
WEB_BASE_URL=https://YOUR_FRONTEND_ORIGIN

# Optional: Cloud SQL instance connection name for --add-cloudsql-instances
# CLOUD_SQL_INSTANCE=ai-project-490516:us-central1:webcast
