{
  "title": "LiveKit SFU",
  "uid": "livekit-sfu",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active rooms",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "livekit_room_total", "legendFormat": "rooms" }]
    },
    {
      "id": 2,
      "title": "Active participants (concurrency)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(livekit_participant_total)", "legendFormat": "participants" }]
    },
    {
      "id": 3,
      "title": "Published / subscribed tracks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(livekit_track_published_total) by (kind)", "legendFormat": "published {{kind}}" },
        { "expr": "sum(livekit_track_subscribed_total) by (kind)", "legendFormat": "subscribed {{kind}}" }
      ]
    },
    {
      "id": 4,
      "title": "CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=\"livekit\"}[5m])", "legendFormat": "cpu" }]
    },
    {
      "id": 5,
      "title": "Memory (resident)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"livekit\"}", "legendFormat": "RSS bytes" }]
    },
    {
      "id": 6,
      "title": "Session join latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(livekit_session_join_latency_ms_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(livekit_session_join_latency_ms_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 7,
      "title": "Track publish/subscribe outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(livekit_track_publish_counter[5m])) by (state)", "legendFormat": "publish {{state}}" },
        { "expr": "sum(rate(livekit_track_subscribe_counter[5m])) by (state)", "legendFormat": "subscribe {{state}}" }
      ]
    },
    {
      "id": 8,
      "title": "Room duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(livekit_room_duration_seconds_bucket[30m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(livekit_room_duration_seconds_bucket[30m])) by (le))", "legendFormat": "p95" }
      ]
    }
  ]
}
