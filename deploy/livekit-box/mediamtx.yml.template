# Live origin for Edge delivery.
#
# LiveKit Egress (on this box, or on egress workers in remote-egress mode) pushes RTMP to
# :1935/live/{slug}. MediaMTX repackages it as plain HLS — no re-encode — and Caddy serves it on
# /live/{slug}/index.m3u8, where viewers play it directly or through a CDN pull zone (Bunny).
#
# Until 2026-10-20 this was also the WHEP origin of the CDN Broadcast mode: WebRTC on :8189,
# and an ffmpeg per live mix re-encoding the audio to Opus for it. That mode was retired, and
# with it the transcode, which was running for every Edge webinar on the SFU box's CPU.

logLevel: info
logDestinations: [stdout]

authMethod: internal
authInternalUsers:
  # Egress (local or from the VPC) and Caddy, which proxies every HLS request from 127.0.0.1.
  - user: any
    pass:
    ips: __PUBLISH_IPS__
    permissions:
      - action: publish
      - action: read
      - action: playback
  # The metrics listener below, for Alloy on this host (docker-compose.alloy.yml) and the local
  # Prometheus. Loopback only, whatever __PUBLISH_IPS__ holds in remote-egress mode.
  - user: any
    pass:
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: metrics

# No RTSP: it was only the WHEP transcode's own loopback transport.
rtsp: false
rtmp: true
# 127.0.0.1 normally. In remote-egress mode the egress workers push from the VPC, so it
# listens on all interfaces; publishing is still limited to the IPs above (loopback plus the
# VPC range), and neither the cloud firewall nor ufw opens 1935 to the internet.
rtmpAddress: __RTMP_ADDRESS__
hls: true
hlsAddress: 127.0.0.1:8888
hlsAllowOrigins: ["*"]
# Off: a muxer is created on demand the moment a viewer (or the CDN) asks for a playlist,
# so a mix nobody watches costs nothing; the first seconds of a new playlist are colder.
hlsAlwaysRemux: false
# Plain HLS: whole fMP4 segments, no parts and no blocking playlist reloads. Until 2026-10-25
# this was lowLatency (1s segments, 250–500ms parts), and through Bunny the blocking reloads
# failed under a real audience: request coalescing tied every viewer waiting for the next part
# to one origin request, and those got stuck (89 viewers at one edge on one request; see
# web/lib/edge-hls.ts). Plain HLS is about one request a second per viewer, all of it
# cacheable. Since 2026-10-26 the segments are 1s and the player sits ~3s back (~3–4s behind
# live), not 2s and ~6s: closer to live, still plain HLS (docs/decisions/2026-10-26-audience-delivery.md).
hlsVariant: fmp4
# Ten segments of 1s: the player sits three back (web/lib/edge-hls.ts TARGET_SECONDS), and the
# rest is room for a viewer who stalled to catch up inside the ~10s window. A segment is cut on
# a keyframe, and the edge mix pins a 1s keyframe interval (broadcastEncodingOptions in
# api/internal/lk/lk.go), so every segment is one GOP. Were keyframes 2s apart, MediaMTX would
# silently make 2s segments whatever this says.
hlsSegmentCount: 10
hlsSegmentDuration: 1s
hlsMuxerCloseAfter: 60s
# Every HLS request reaches MediaMTX through Caddy, which sets this as
# `Authorization: Bearer` (see the Caddyfile). Without it MediaMTX treats each
# viewer as its own session: the first playlist request is a 302 to
# ?cookieCheck=1, every playlist and part URL carries that viewer's
# session=<token>, and responses are no-cache. Behind the Bunny pull zone that
# made every viewer's URLs unique, so nothing was shared from the CDN cache and
# every LL-HLS request went to this box: ~0.7s each from India, which LL-HLS
# cannot keep up with (6-8s behind, 2026-10-19). With it, one shared session
# and the same URLs for everyone.
#
# Not a credential: MediaMTX listens on localhost only, read is open to anyone
# anyway, and Caddy overwrites whatever Authorization a client sends.
hlsCDNSecret: webinarliv-origin
webrtc: false
srt: false
# MoQ is new in 1.21 and defaults to on, which is three more listeners (:8892
# TCP and UDP, :8893 UDP) and a self-signed certificate generated at boot, for
# a protocol nothing here speaks.
moq: false
api: false
# Prometheus metrics (paths, readers, bytes) for Alloy and the local Prometheus. Loopback only:
# 9998 is on neither the ufw allow-list nor the cloud firewall, and Caddy does not proxy it.
metrics: true
metricsAddress: 127.0.0.1:9998
pprof: false
playback: false

paths:
  # Cloud recording of an edge webinar (api/internal/api/mixrec.go). While a host records, the
  # API gives the running mix a second RTMP output, rec/{slug}: the same encoded stream, so no
  # second compositor and no change to live/{slug}, which the audience watches. Everything
  # pushed here is written to /recordings/rec/{slug}/ as fMP4 segments, which the mix recorder
  # (mixrec/) joins into an MP4, uploads and deletes. Nothing pushes here unless the API asked
  # it to, so with the recorder off this costs nothing.
  #
  # A path of its own rather than `record` toggled on live/{slug} through MediaMTX's API: a
  # named config for a path all_others is serving makes MediaMTX close that path, dropping
  # the egress's publish (the audience's stream), and recording all_others records every room.
  "~^rec/":
    record: true
    recordPath: /recordings/%path/%Y-%m-%d_%H-%M-%S-%f
    recordFormat: fmp4
    recordPartDuration: 1s
    recordSegmentDuration: 15m
    # A backstop only: the recorder deletes segments once the API has the file. Kept long
    # enough to recover one by hand if an upload failed.
    recordDeleteAfter: 72h
  all_others:
