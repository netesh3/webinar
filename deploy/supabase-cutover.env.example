# Copy to deploy/supabase-cutover.env (gitignored) and fill in.
# Then: ./deploy/migrate-supabase.sh
#
# Use DIRECT Postgres URIs (db.<ref>.supabase.co:5432) for dump/restore.
# Session pooler (:5432 pooler host) is for Cloud Run, not pg_dump.

# Current production (webcast-in)
SRC_DATABASE_URL=

# New Pro project — direct URI, sslmode=require
DST_DATABASE_URL=

# After restore, Cloud Run / GitHub secrets (session pooler is fine here):
# DST_DATABASE_URL_POOLER=postgres://postgres.<NEW_REF>:SECRET@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DST_SUPABASE_URL=https://YOUR_NEW_REF.supabase.co
DST_SUPABASE_ANON_KEY=
# Optional: only if the new project still uses HS256
DST_SUPABASE_JWT_SECRET=
