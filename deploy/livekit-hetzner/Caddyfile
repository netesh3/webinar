# Live origin in front of MediaMTX: its plain HLS on /live/*, for Edge viewers, played
# directly or through the CDN pull zone. flush_interval -1 so a segment streams out as
# MediaMTX writes it rather than sitting in a proxy buffer.
#
# No CORS headers here. MediaMTX already sends them; a second
# Access-Control-Allow-Origin makes browsers reject the response.
#
# (The WHEP routes, /live/{slug}/whep and /wrtc/*, went with the CDN Broadcast mode.)

(live_origin) {
	handle /live/* {
		reverse_proxy 127.0.0.1:8888 {
			flush_interval -1
			# MediaMTX's hlsCDNSecret: one shared session and cacheable URLs instead of a
			# cookieCheck redirect and a session token per viewer (mediamtx.yml.template).
			header_up Authorization "Bearer webinarliv-origin"
		}

		# `>` defers the header until MediaMTX has answered, so it replaces MediaMTX's own
		# "private, no-cache" instead of being sent beside it. With both, the CDN pull zone
		# honoured the private one and cached nothing: every viewer went to the origin.
		#
		# Successful responses only. A segment asked for before it exists is a 404 from
		# MediaMTX; cached at the CDN that would be a hole in the stream for every viewer
		# behind that edge. Errors are never stored (below).
		#
		# Playlists change every segment (1s): a second at the CDN shares one fetch between
		# everyone at an edge and still has them see each new segment within a second.
		# Segments and the init segment never change once written and their names are unique
		# to the muxer, so they can be kept as long as anyone could ask for them.
		@playlist path *.m3u8
		header @playlist {
			Cache-Control "max-age=1, s-maxage=1, public"
			match {
				status 2xx
			}
		}
		@segment path *.mp4 *.m4s *.ts
		header @segment {
			Cache-Control "public, max-age=300, s-maxage=300, immutable"
			match {
				status 2xx
			}
		}
		header /live/* {
			Cache-Control "no-store"
			match {
				status 3xx 4xx 5xx
			}
		}
	}
}

# The mix recorder (mixrec/, docker-compose.mixrec.yml): start/stop calls from the API, which
# finds it at <live origin>/../mixrec. It checks X-Mixrec-Secret itself. Not running (no
# MIXREC_SECRET in .env) is a 502, and the API then records as before.
(mix_recorder) {
	handle_path /mixrec/* {
		reverse_proxy 127.0.0.1:7895
	}
}

{$DOMAIN} {
	encode gzip

	import live_origin
	import mix_recorder

	# `handle` (not `handle_path`) — Grafana's GF_SERVER_SERVE_FROM_SUB_PATH
	# expects the /grafana prefix to still be in the request it receives and
	# does its own subpath routing. handle_path strips that prefix, so
	# Grafana's internal redirect (via its own root_url) sends the client
	# back to /grafana/, which gets stripped again — an infinite 301 loop.
	handle /grafana/* {
		reverse_proxy 127.0.0.1:3000
	}

	reverse_proxy 127.0.0.1:7880
}

# Hostname used when BROADCAST_HLS_BASE points at live.webinarliv.com (behind Cloudflare).
#
# `tls internal` rather than a public certificate. Behind the orange cloud an
# HTTP-01 challenge is answered by Cloudflare's edge, not by Caddy. The zone
# is Full (not Full strict), so Cloudflare encrypts to origin and accepts this
# locally-issued certificate. Un-proxying this record is an outage for this
# hostname: the local certificate will not validate in a browser. The same origin is
# also served on {$DOMAIN} (sslip.io), which is what the CDN pull zones use.
live.webinarliv.com {
	tls internal

	import live_origin
	import mix_recorder

	handle {
		respond 404
	}
}
