# Shared by the SFU hostname and (once DNS exists) live.webinarliv.com.
# encode off + flush_interval -1: LL-HLS parts are tiny and blocking; gzip
# and proxy buffering add seconds back onto the path we just shortened.
(live_hls) {
	handle /live/* {
		encode off
		reverse_proxy 127.0.0.1:8888 {
			flush_interval -1
		}
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Access-Control-Expose-Headers "*"
		@playlist path *.m3u8
		header @playlist Cache-Control "max-age=1, s-maxage=1, public"
		@part path *.m4s *.mp4 *.ts
		header @part Cache-Control "public, max-age=30, s-maxage=60"
	}
}

{$DOMAIN} {
	encode gzip
	import live_hls

	# `handle` (not `handle_path`) — Grafana's GF_SERVER_SERVE_FROM_SUB_PATH
	# expects the /grafana prefix to still be in the request it receives and
	# does its own subpath routing. handle_path strips that prefix, so
	# Grafana's internal redirect (via its own root_url) sends the client
	# back to /grafana/, which gets stripped again — an infinite 301 loop.
	handle /grafana/* {
		reverse_proxy 127.0.0.1:3000
	}

	reverse_proxy 127.0.0.1:7880
}

# Orange-cloud this hostname on Cloudflare so HLS parts fan out at the edge
# instead of the Hetzner 1 Gbps NIC. Until the A record exists Caddy will
# retry ACME; the {$DOMAIN} site above still serves.
live.webinarliv.com {
	import live_hls
	handle {
		respond "live origin" 200
	}
}
