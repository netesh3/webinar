{$DOMAIN} {
	encode gzip

	# LL-HLS parts from MediaMTX. flush_interval -1 disables proxy buffering:
	# a 200ms part held in a buffer puts back the latency this path exists to
	# remove. No `encode` here — the directive only takes encoder names, and
	# these segments are already compressed.
	handle /live/* {
		reverse_proxy 127.0.0.1:8888 {
			flush_interval -1
		}
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		@playlist path *.m3u8
		header @playlist Cache-Control "max-age=1, s-maxage=1, public"
		@part path *.m4s *.mp4 *.ts
		header @part Cache-Control "public, max-age=30, s-maxage=60"
	}

	# `handle` (not `handle_path`) — Grafana's GF_SERVER_SERVE_FROM_SUB_PATH
	# expects the /grafana prefix to still be in the request it receives and
	# does its own subpath routing. handle_path strips that prefix, so
	# Grafana's internal redirect (via its own root_url) sends the client
	# back to /grafana/, which gets stripped again — an infinite 301 loop.
	handle /grafana/* {
		reverse_proxy 127.0.0.1:3000
	}

	reverse_proxy 127.0.0.1:7880
}

# No site block for live.webinarliv.com. Caddy manages a certificate for every
# hostname it is configured to serve, and that record does not exist yet, so
# naming it here only buys failing ACME orders. Add the block in the same
# change that adds the DNS record — see README.
