# Live origin in front of MediaMTX.
#
# WHEP signaling must win over the catch-all /live/* HLS proxy: the same path
# prefix carries /whep (HTTP POST of SDP) and, after 201, /whep/<session>.
# flush_interval -1 so neither SDP nor LL-HLS parts sit in a proxy buffer.
#
# No CORS headers here. MediaMTX already sends them; a second
# Access-Control-Allow-Origin makes browsers reject the response.

(live_origin) {
	@whep path_regexp ^/live/.+/whep
	handle @whep {
		reverse_proxy 127.0.0.1:8889 {
			flush_interval -1
		}
		header Cache-Control "private, no-store"
	}

	handle /live/* {
		reverse_proxy 127.0.0.1:8888 {
			flush_interval -1
		}

		@playlist path *.m3u8
		header @playlist Cache-Control "max-age=1, s-maxage=1, public"
		@part path *.m4s *.mp4 *.ts
		header @part Cache-Control "public, max-age=30, s-maxage=60"
	}
}

{$DOMAIN} {
	encode gzip

	import live_origin

	# `handle` (not `handle_path`) — Grafana's GF_SERVER_SERVE_FROM_SUB_PATH
	# expects the /grafana prefix to still be in the request it receives and
	# does its own subpath routing. handle_path strips that prefix, so
	# Grafana's internal redirect (via its own root_url) sends the client
	# back to /grafana/, which gets stripped again — an infinite 301 loop.
	handle /grafana/* {
		reverse_proxy 127.0.0.1:3000
	}

	reverse_proxy 127.0.0.1:7880
}

# Hostname used when BROADCAST_HLS_BASE points at live.webinarliv.com.
# Signaling can sit behind Cloudflare; ICE UDP does not — MediaMTX advertises
# the box IPv4 on :8189. Do not cache WHEP (the handle above sets no-store).
#
# `tls internal` rather than a public certificate. Behind the orange cloud an
# HTTP-01 challenge is answered by Cloudflare's edge, not by Caddy. The zone
# is Full (not Full strict), so Cloudflare encrypts to origin and accepts this
# locally-issued certificate. Un-proxying this record is an outage for this
# hostname: the local certificate will not validate in a browser. WHEP can
# also be served on {$DOMAIN} (sslip.io) if you point BROADCAST_HLS_BASE there.
live.webinarliv.com {
	tls internal

	import live_origin

	handle {
		respond 404
	}
}
