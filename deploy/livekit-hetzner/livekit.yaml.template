# Single-node LiveKit for ~200 webinar subscribers.
# Keys and TURN domain are substituted at install time.

port: 7880

rtc:
  port_range_start: 50000
  port_range_end: 60000
  tcp_port: 7881
  use_external_ip: true
  stun_servers:
    - stun.l.google.com:19302
    - stun1.l.google.com:19302

logging:
  level: info
  json: true

# Exposes /metrics on this port for the local Prometheus container (same
# docker-compose stack, scraped over the host network). install.sh's ufw
# rules are an allow-list (deny-by-default) and 7801 is not on it, so this
# stays unreachable from the internet as long as nobody adds a
# `ufw allow 7801` rule for it.
#
# NOTE: bumping this file forces redeploy.sh's content-diff check to fire a
# one-time `docker compose restart livekit` — needed because prometheus_port
# was added to this template in an earlier redeploy that never actually
# restarted the (bind-mounted-config, restart-only-reads-at-startup) livekit
# container, so it's been silently not listening on 7801 ever since.
prometheus_port: 7801

room:
  auto_create: false
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 220

turn:
  enabled: true
  domain: __TURN_DOMAIN__
  udp_port: 3478
  # LiveKit embedded TURN; TLS for TURN is optional when UDP/TCP work.

keys:
  __API_KEY__: __API_SECRET__

# Redis for LiveKit Egress (protocol buffers RPC over Redis pub/sub).
# Required when running docker-compose.egress.yml.
redis:
  address: 127.0.0.1:6379

# Webhook configuration: sends EGRESS_ENDED to Go API so recording row is finalized.
webhook:
  api_key: __API_KEY__
  urls:
    - https://webinarliv.com/api/webhooks/livekit
