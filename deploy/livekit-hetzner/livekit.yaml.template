# Single-node LiveKit for ~200 webinar subscribers.
# Keys and TURN domain are substituted at install time.

port: 7880

rtc:
  port_range_start: 50000
  port_range_end: 60000
  tcp_port: 7881
  use_external_ip: true
  stun_servers:
    - stun.l.google.com:19302
    - stun1.l.google.com:19302

logging:
  level: info
  json: true

room:
  auto_create: false
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 220

turn:
  enabled: true
  domain: __TURN_DOMAIN__
  udp_port: 3478
  # LiveKit embedded TURN; TLS for TURN is optional when UDP/TCP work.

keys:
  __API_KEY__: __API_SECRET__
