// Grafana Alloy on the video box (docker-compose.alloy.yml): metrics and container logs to
// Grafana Cloud. Started by redeploy.sh only when the GRAFANA_CLOUD_* settings are in .env;
// it writes them, and ALLOY_BOX (the label that names this droplet), to alloy.env.
//
// Budget: the Grafana Cloud free tier is 10k active series. Everything below is trimmed to a
// few thousand at most: an allow-list of host metrics, a handful of per-container metrics,
// and the Go runtime noise dropped from LiveKit and MediaMTX.

// ---------------------------------------------------------------------------------- metrics

// LiveKit (livekit.yaml.template, prometheus_port) and MediaMTX (mediamtx.yml.template),
// both on loopback only. MediaMTX runs only with docker-compose.egress.yml; when it is not
// there the target is simply down (up == 0).
prometheus.scrape "apps" {
	targets = [
		{"__address__" = "127.0.0.1:7801", "job" = "livekit"},
		{"__address__" = "127.0.0.1:9998", "job" = "mediamtx"},
	]
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.apps.receiver]
}

prometheus.relabel "apps" {
	// The Go runtime and HTTP handler series both servers export: dozens each, never looked at.
	// go_goroutines and the process_* series (CPU, memory, fds) are kept.
	rule {
		source_labels = ["__name__"]
		regex         = "go_(gc|memstats|sched|cgo|cpu|godebug|sync|info|threads)_.*|go_gc_duration_seconds.*|promhttp_.*"
		action        = "drop"
	}
	forward_to = [prometheus.remote_write.cloud.receiver]
}

// Host metrics (node_exporter, embedded). Only the collectors and series worth a dashboard.
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/sys"
	rootfs_path = "/host/root"

	set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "netstat", "pressure", "uname"]

	filesystem {
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+|snap/.+)($|/)"
	}

	netdev {
		// Host networking: the real NIC(s) only, not docker's bridges and veths.
		device_exclude = "^(lo|docker.*|br-.*|veth.*)$"
	}

	disk {
		device_exclude = "^(ram|loop|fd|(h|s|v|xv)d[a-z]|nvme\\d+n\\d+p)\\d+$"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.host.receiver]
}

prometheus.relabel "host" {
	rule {
		target_label = "job"
		replacement  = "node"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "node_(cpu_seconds_total|load1|load5|load15|memory_(MemTotal|MemAvailable|MemFree|Buffers|Cached|SwapTotal|SwapFree)_bytes|filesystem_(size|avail|free)_bytes|filesystem_files(_free)?|disk_(read|written)_bytes_total|disk_io_time_seconds_total|disk_(reads|writes)_completed_total|network_(receive|transmit)_(bytes|packets|drop|errs)_total|netstat_(Tcp_CurrEstab|Tcp_RetransSegs|Tcp_OutSegs|Udp_InErrors|Udp_RcvbufErrors|Udp_SndbufErrors|Udp_InDatagrams|Udp_OutDatagrams)|pressure_.*|uname_info|boot_time_seconds)"
		action        = "keep"
	}

	// Per-CPU by mode is 10 series a core; only the guest modes (always 0 on a droplet) go.
	// softirq is where the kernel's network work shows (viewers on the origin, the SFU's UDP)
	// and nice is the captions agent and the mix recorder (both run niced): without them,
	// user + system missed ~0.45 of the 3.9 busy cores at the 2026-10-24 load test.
	rule {
		source_labels = ["__name__", "mode"]
		regex         = "node_cpu_seconds_total;(guest|guest_nice)"
		action        = "drop"
	}
	forward_to = [prometheus.remote_write.cloud.receiver]
}

// Container metrics (cAdvisor, embedded), per compose service.
prometheus.exporter.cadvisor "containers" {
	docker_host      = "unix:///var/run/docker.sock"
	docker_only      = true
	storage_duration = "2m"

	// Never keep container labels or env as metric labels (they would include settings).
	store_container_labels       = false
	allowlisted_container_labels = ["com.docker.compose.service"]
	env_metadata_allowlist       = []

	// Everything per-process, per-disk and per-interface; the host network makes the network
	// series one copy of the host's for every container anyway.
	disabled_metrics = ["advtcp", "cpu_topology", "cpuset", "disk", "diskIO", "hugetlb", "memory_numa", "network", "percpu", "perf_event", "process", "referenced_memory", "resctrl", "sched", "tcp", "udp"]
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
	rule {
		target_label = "job"
		replacement  = "cadvisor"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_(cpu_usage_seconds_total|cpu_cfs_throttled_seconds_total|memory_working_set_bytes|memory_rss|spec_memory_limit_bytes|oom_events_total|start_time_seconds|last_seen)"
		action        = "keep"
	}

	// The root cgroup and the system slices: only named (docker) containers.
	rule {
		source_labels = ["name"]
		regex         = ""
		action        = "drop"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		regex  = "id|image|container_label_com_docker_compose_service"
		action = "labeldrop"
	}
	forward_to = [prometheus.remote_write.cloud.receiver]
}

prometheus.remote_write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}

	external_labels = {
		box = sys.env("ALLOY_BOX"),
	}
}

// ------------------------------------------------------------------------------------- logs

// Every container on the box, through the docker socket (read-only mount).
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/?(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.logs.rules
	forward_to    = [loki.process.logs.receiver]
}

loki.process "logs" {
	// Debug and trace lines (logfmt, JSON or plain level words) are not worth shipping.
	stage.drop {
		expression = "(?i)(level=(debug|trace)\\b|\"level\":\\s*\"(debug|trace)\"|^\\S*\\s*\\S*\\s*(DEBUG|TRACE|DEB)\\s)"
	}

	forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}

	external_labels = {
		box = sys.env("ALLOY_BOX"),
	}
}
