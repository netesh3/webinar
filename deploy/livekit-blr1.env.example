# Bangalore SFU (DigitalOcean BLR1) — values for a MANUAL first install.
# The usual path is the "Deploy LiveKit (Hetzner)" workflow with target blr1 + install,
# which passes these for you (docs/SFU-BANGALORE.md). By hand, as root on the droplet,
# after rsync-ing deploy/livekit-hetzner/ to /opt/livekit:
#
#   set -a; . ./livekit-blr1.env; set +a
#   bash /opt/livekit/install.sh
#
# Never commit real values.

# Signalling + TURN hostname (Cloudflare DNS only / grey cloud).
DOMAIN=sfu-in.webinarliv.com
# Let's Encrypt contact for Caddy.
ACME_EMAIL=support@webinarliv.com
# The droplet's public IPv4 — LiveKit advertises it (STUN alone is flaky on some clouds).
NODE_IP=203.0.113.10
# Proxied attendee broadcast origin served by this box (Cloudflare orange cloud).
LIVE_ORIGIN_HOST=live-in.webinarliv.com
# Same values as the API's LIVEKIT_PROJECTS "blr1" entry (and the repo secrets
# SFU_BLR1_LIVEKIT_KEY / SFU_BLR1_LIVEKIT_SECRET).
API_KEY=APIxxxxxxxxxxxxxxxx
API_SECRET=replace-with-openssl-rand-hex-32
