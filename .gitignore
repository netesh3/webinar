# runtime state written by start.sh
.run/

# compiled binaries
infra/bin/
api/bin/

# recordings, when the disk backend keeps them inside the repo (the default for
# local development — RECORDINGS_DIR moves them anywhere else)
.data/

# secrets
.env
.env.prod

# make deploy-backup writes here
backups/

# Temporary EKS deploy: generated secrets and rendered manifests.
k8s/.secrets.env
k8s/.rendered/
k8s/.backup/
k8s/.prev-context

# OS / archive junk
.DS_Store
__MACOSX/

# local editor / agent settings
.claude/

# Cloud Run local secrets (copy from deploy/cloudrun.env.example)
deploy/cloudrun.env

# Supabase project cutover (copy from deploy/supabase-cutover.env.example)
deploy/supabase-cutover.env

# Supabase CLI local temp (project link cache)
supabase/.temp/

# Wrangler local cache (account id, etc.)
.wrangler/

# Firebase CLI debug output
firebase-debug.log

# Rendered mock images and bundles (regenerate with each mock folder's render script)
docs/mockups/**/*.png
docs/mockups/**/*.zip
docs/architecture/*.visual-check.*.png
