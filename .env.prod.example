# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod    # then fill in the four secrets below
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Compose refuses to start if any of the required values are missing, rather than
# booting with a blank password. .env.prod is gitignored — keep it that way.

# ------------------------------------------------------------------ required

# The hostname the app is served on. sfu.$DOMAIN must also resolve here: it is the
# SFU's signalling endpoint, and the API refuses to boot unless it can hand the
# browser a wss:// URL.
#
#   A    events.example.com        ->  <this server's IPv4>
#   A    sfu.events.example.com    ->  <this server's IPv4>
#   A    turn.events.example.com   ->  <this server's IPv4>
#
# The third one is TURN. It is not optional in the way it looks: without a relay
# candidate, a client whose network blocks direct media does not fail fast — it
# retries for tens of seconds and often never connects. That is the usual cause of
# "audio and video only appear after a couple of minutes".
DOMAIN=events.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Generate each of these once, on the server, and never reuse them between
# environments:
#
#   openssl rand -hex 32
#
POSTGRES_PASSWORD=
SESSION_SECRET=
LIVEKIT_API_SECRET=

# The SFU's room API, as this API process reaches it. Left unset it is derived from
# LIVEKIT_URL, which sends every mute and permission change back out through Caddy;
# docker-compose.prod.yml sets it to the container address instead. Only override it
# if the SFU is somewhere else entirely.
#LIVEKIT_HTTP_URL=http://livekit:7880

# The key is an identifier, not a secret, but it still has to match on both sides —
# the API signs tokens with it and the SFU verifies them.
LIVEKIT_API_KEY=webcast

# ------------------------------------------------------------------ optional

APP_NAME=Webinar Liv
SUPPORT_EMAIL=

# Close signup once your own accounts exist, or anybody who finds the URL can make
# one. Hosting still has to be granted per account.
SIGNUP_OPEN=true

# 500 is the ceiling for one SFU node on unmetered gigabit. JOIN_RATE_PER_MIN must
# be at least this, and the API refuses to start otherwise: a corporate audience
# arrives from one egress IP, so a limit sized for one person retrying locks out the
# building.
MAX_ATTENDEES=500
JOIN_RATE_PER_MIN=1200

# Shortest password an account may have. Below 10 is refused outside development.
MIN_PASSWORD_LENGTH=10

# Recording is done by the browser of whoever presses record and uploaded to the
# API, which writes it to the `recordings` volume. An hour of 720p is roughly 1 GB,
# so size the volume for how much you intend to keep.
RECORDINGS_ENABLED=true
MAX_RECORDING_MB=4096
