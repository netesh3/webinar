# Copy to .env and fill in for a real deployment. The API refuses to start
# outside development if the secrets are still the development defaults.

# ------------------------------------------------------------------ API
APP_ENV=production            # development | production
ADDR=:8080

# Local docker-compose Postgres, or a Supabase URI for shared/dev cloud DB.
# Supabase requires sslmode=require — see deploy/SUPABASE.md.
DATABASE_URL=postgres://webcast:CHANGE_ME@postgres:5432/webcast?sslmode=require
# DATABASE_URL=postgres://postgres:SECRET@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------ branding
# Served to the frontend over GET /api/config, so none of this is baked into the
# JavaScript bundle. WEB_BASE_URL is what share links are built from — get it
# wrong and every registration link you hand out points somewhere else. It
# defaults to the first CORS_ORIGINS entry.
APP_NAME=Webcast
WEB_BASE_URL=https://events.example.com
SUPPORT_EMAIL=

# Set to false to close new account creation. Attendees can still register for a
# webinar without an account either way.
SIGNUP_OPEN=true

# ------------------------------------------------------------------ LiveKit
# The ws(s):// URL is handed to browsers, so it must be reachable from the
# public internet and must be wss:// in production (a ws:// SFU on an https://
# page is blocked as mixed content). The API refuses to start otherwise.
LIVEKIT_URL=wss://sfu.example.com
LIVEKIT_API_KEY=CHANGE_ME
# openssl rand -hex 32
LIVEKIT_API_SECRET=CHANGE_ME

# ------------------------------------------------------------------ sessions
# openssl rand -hex 32 — rotating this signs everyone out.
SESSION_SECRET=CHANGE_ME
SESSION_TTL=24h
COOKIE_SECURE=true            # must be true outside development

# ------------------------------------------------------------------ limits
# 500 concurrent attendees is the pure-WebRTC ceiling for a single SFU node
# (~500 x 2 Mbps ~= 1 Gbps of egress). Past this, add the LL-HLS tier rather
# than raising this number.
MAX_ATTENDEES=500
LIVEKIT_TOKEN_TTL=2h
SHUTDOWN_GRACE=15s

# Rate limits, per client IP per minute.
#
# JOIN_RATE_PER_MIN must be at least MAX_ATTENDEES and the API refuses to start
# otherwise. Attendees arrive at the top of the hour, and a corporate audience
# arrives from a single egress IP — a limit sized for one person retrying locks
# out an entire office, and presents as "the webinar is broken".
REGISTER_RATE_PER_MIN=30
JOIN_RATE_PER_MIN=1200

# Comma-separated. Must list the exact frontend origin — credentials are sent
# with every request, so a wildcard will not work.
CORS_ORIGINS=https://events.example.com

# Demo hosts and webinars for an empty development database. Turn this off once
# the instance is yours: the seed fires whenever the users table is empty, so
# otherwise deleting the demo accounts recreates them on the next restart. It never
# runs outside development regardless.
SEED_DEV=false

# Shortest password an account may have. A length floor rather than a
# character-class rule: composition rules push people towards "Password1!" and
# measurably do not help. Development defaults to 4 so whoever is building this is
# not typing a long password all day; outside development the API refuses anything
# below 10, so that convenience cannot follow the deployment into production.
MIN_PASSWORD_LENGTH=10

# ---------------------------------------------------------------- recordings
# Recording is done by the browser of whoever presses record and uploaded here in
# chunks. The host and any panelist may start one; the audience cannot.
#
# RECORDINGS_BACKEND is the storage seam. "disk" is the only implementation today
# and the API refuses to start with any other value rather than silently dropping
# the bytes — so when this becomes "s3", it will be because the code for it exists.
#
# Put RECORDINGS_DIR on a volume you have actually sized. An hour of 720p is
# roughly 1 GB, and MAX_RECORDING_MB is the per-recording ceiling that stops a
# forgotten one from filling the disk and taking the API down with it.
RECORDINGS_ENABLED=true
RECORDINGS_BACKEND=disk
RECORDINGS_DIR=/var/lib/webcast/recordings
MAX_RECORDING_MB=4096

# ------------------------------------------------------------------ frontend
# Baked into the client bundle at build time, so it must be the public URL.
NEXT_PUBLIC_API_BASE=https://api.example.com
