      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "doors open 15 min before startsAt   \u00b7   409 too_early before that, with the time in the webinar's own zone\npasscode checked at REGISTRATION, because that is the only place a join key is minted\nattendee chat / polls / hands go through the API, not the data channel - their token cannot publish data",
      "originalText": "doors open 15 min before startsAt   \u00b7   409 too_early before that, with the time in the webinar's own zone\npasscode checked at REGISTRATION, because that is the only place a join key is minted\nattendee chat / polls / hands go through the API, not the data channel - their token cannot publish data",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 11
    },
