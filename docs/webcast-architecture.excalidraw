      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "1  lib/access.ts + middleware.ts   answers before a page renders, so nothing host-shaped is ever sent\n2  the API                          requireHost / requireOwnership on every host route\n3  the LiveKit token                canPublish is decided server-side; a client cannot ask for a role",
      "originalText": "1  lib/access.ts + middleware.ts   answers before a page renders, so nothing host-shaped is ever sent\n2  the API                          requireHost / requireOwnership on every host route\n3  the LiveKit token                canPublish is decided server-side; a client cannot ask for a role",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 11
    },
    {
      "id": "text-119-7651",
