{
  "name": "webinarliv-desktop",
  "productName": "Webinar Liv",
  "version": "0.1.5",
  "private": true,
  "description": "Webinar Liv desktop app for macOS and Windows",
  "author": {
    "name": "Webinar Liv",
    "email": "support@webinarliv.com"
  },
  "homepage": "https://webinarliv.com",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings src/config.test.mts && node --experimental-strip-types --no-warnings src/share-policy.test.mts && node --experimental-strip-types --no-warnings src/qos.test.mts",
    "start": "npm run build && electron .",
    "icons": "bash scripts/make-icons.sh",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "pack:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  }
}
