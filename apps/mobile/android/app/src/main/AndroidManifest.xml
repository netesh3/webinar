<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: a tapped https://webinarliv.com join / webinar link
                 (WhatsApp, Gmail, SMS) opens the app instead of the browser. autoVerify
                 checks https://webinarliv.com/.well-known/assetlinks.json, which must list
                 the SHA-256 of the key the installed build is signed with (README.md,
                 <ANDROID_SHA256_CERT_FINGERPRINT>). Unverified, Android shows a chooser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="webinarliv.com" />
                <data android:host="www.webinarliv.com" />
                <data android:pathPrefix="/webinars/" />
                <data android:pathPrefix="/w/" />
                <data android:pathPrefix="/host/" />
                <data android:pathPrefix="/recordings" />
                <data android:pathPrefix="/my-webinars" />
                <data android:pathPrefix="/verify-email" />
                <data android:pathPrefix="/reset-password" />
            </intent-filter>

            <!-- Fallback custom scheme: webinarliv://webinars/<id> opens
                 https://webinarliv.com/webinars/<id> inside the app (web/lib/native-bridge.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="webinarliv" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Keeps the WebView in the FOREGROUND bucket during a live room so
             Android does not kill it under memory pressure (CallQosService). -->
        <service
            android:name=".CallQosService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Incoming calls (CallRinging.java; 31 Oct 2026). CallMessagingService takes FCM's
             messages instead of @capacitor-firebase/messaging's MessagingService (removed here),
             rings for call messages even when the app was swiped away, and passes everything
             else on to the plugin. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.firebase.messaging.MessagingService"
            tools:node="remove" />
        <service
            android:name=".CallMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Decline, from the notification or the call screen, without opening the app. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
        <!-- The full-screen incoming call, over the lock screen. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.webinarliv.app.call"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wi-Fi high-perf / low-latency lock and a CPU wake lock during a live room. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service so a live webinar is not treated as a background tab. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- WebRTC (LiveKit) in the WebView. Capacitor's BridgeWebChromeClient already
         implements onPermissionRequest: it asks for the runtime permission(s) matching
         the page's getUserMedia request and then grants the WebView's PermissionRequest,
         so no custom WebChromeClient is needed, only these declarations. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth headsets for call audio on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Push (Android 13+ runtime prompt); @capacitor-firebase/messaging's FCM library also merges it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Incoming calls (31 Oct 2026): the call screen over the lock screen (Android 14+ asks
         the user; CallRingingPlugin.openFullScreenSettings), and vibration before Android 8's
         notification channels. No phoneCall foreground service: a CallStyle notification with
         a full-screen intent needs none, and the meeting itself runs in the WebView. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Not required: attendees without a camera can still watch and talk. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
