{
  "name": "webinarliv-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Webinar Liv for Android and iOS: a Capacitor shell around https://webinarliv.com",
  "scripts": {
    "sync": "cap sync",
    "assets": "node scripts/make-icon-source.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#0b5cff' --iconBackgroundColorDark '#0b5cff' --splashBackgroundColor '#0b5cff' --splashBackgroundColorDark '#0d0d11'",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "cap run ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0"
  }
}
